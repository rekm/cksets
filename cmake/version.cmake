file (STRINGS "${CMAKE_CURRENT_LIST_DIR}/../include/version.hpp" KSETS_VERSION_HPP
      REGEX "#define KSETS_VERSION_(MAJOR|MINOR|PATCH)"
)
string (REGEX REPLACE "#define KSETS_VERSION_(MAJOR|MINOR|PATCH) " "" KSETS_VERSION "${KSETS_VERSION_HPP}")
string (REGEX REPLACE ";" "." KSETS_VERSION "${KSETS_VERSION}")

file (STRINGS "${CMAKE_CURRENT_LIST_DIR}/../include/version.hpp" KSETS_RELEASE_CANDIDATE_HPP
      REGEX "#define KSETS_RELEASE_CANDIDATE "
)
string (REGEX REPLACE "#define KSETS_RELEASE_CANDIDATE " "" KSETS_RELEASE_CANDIDATE_VERSION
                      "${KSETS_RELEASE_CANDIDATE_HPP}"
)

set (KSETS_PROJECT_VERSION "${KSETS_VERSION}")

if (KSETS_RELEASE_CANDIDATE_VERSION VERSION_GREATER "0")
    set (KSETS_VERSION "${KSETS_VERSION}-rc.${KSETS_RELEASE_CANDIDATE_VERSION}")
endif ()
